项目概述
产品定位：带"强制引用溯源"的企业私有知识库问答系统，每个回答必须标注文件名+页码，无引用则拒绝回答。核心价值是让AI的回答"可信、可查、可追责"。

一、技术栈（最终确认版）
层级	技术选型	版本/说明
前端	Nuxt 3 + Vue 3 + TypeScript + TailwindCSS	SSR（服务端渲染），企业级UI，PDF预览用pdf-vue3
后端	Spring Boot 3 + Spring AI + JDK 17	核心框架
本地AI	Ollama + Qwen2.5-7B	语义分块 + 问答生成，本地部署零成本
嵌入模型	Ollama + nomic-embed-text 或 BGE-M3	文本向量化
向量数据库	Elasticsearch 8.x（本地） 或 阿里云AnalyticDB MySQL	统一管理向量+关键词(BM25)检索，减少组件
关系数据库	MySQL 8.0	存分块元数据、文档信息、反馈、问答日志
文档解析	PaddleOCR（扫描件OCR）+ Apache PDFBox + Apache POI	支持PDF(含扫描件)/Word/TXT
重排序	BGE-Reranker（BAAI/bge-reranker-base）	精准排序Top 3
部署	Docker Compose（一键启动全部服务）	后端JAR + 前端Node + MySQL + ES + Ollama
二、功能需求（按优先级）
P0 - 必须实现（核心可用）
功能	说明
文档上传与解析	支持PDF（含扫描件OCR）、Word、TXT；提取纯文本、页码、章节标题
智能分块	调用本地Ollama(Qwen2.5-7B)语义分块；记录父块(规则粗切)关系
向量化存储	分块文本→嵌入模型→向量，存入ES；元数据存MySQL
多路召回	用户问题同时走：①向量检索 ②BM25关键词检索 ③HyDE假设答案检索；合并去重
重排序	BGE-Reranker重打分，取Top 3
强制引用回答	大模型回答必须标注【来源：文件名，第X页】；无资料返回"未找到"
引用超链接	前端点击引用跳转PDF对应页码
P1 - 差异化竞争力
功能	说明
分块溯源数据库	MySQL存储每个分块的完整元数据（chunk_id、doc_id、page_num、status、父子版本链等）
父子版本链	支持分块合并/拆分/编辑，记录parent_chunk_id和edited_version_of
用户反馈收集	每个回答下提供👍/👎/引用有误按钮，反馈写入chunk_feedback表
管理后台	查看所有分块列表、按文档筛选、手动编辑/合并/拆分分块、标记问题分块
P2 - 增强优化
功能	说明
多文档矛盾处理	检测参考资料矛盾，回答中全部列出，不自行融合
灰度发布	分块修改后支持仅10%用户生效，验证后全量
PDF预览跳转	前端嵌入pdf-vue3，点击引用链接打开PDF并滚动到对应页码
三、MySQL数据库设计（最终版）
sql
-- 创建数据库
CREATE DATABASE rag_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE rag_db;

-- 1. 文档主表
CREATE TABLE documents (
    doc_id VARCHAR(64) PRIMARY KEY COMMENT '文档唯一ID',
    doc_name VARCHAR(255) NOT NULL COMMENT '文件名',
    file_path VARCHAR(500) COMMENT '存储路径',
    file_size BIGINT COMMENT '文件大小(字节)',
    total_pages INT DEFAULT 0 COMMENT '总页数',
    upload_time DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '上传时间',
    status VARCHAR(20) DEFAULT 'processing' COMMENT 'processing/done/failed',
    INDEX idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='文档主表';

-- 2. 分块表（核心）
CREATE TABLE document_chunks (
    chunk_id VARCHAR(64) PRIMARY KEY COMMENT '分块唯一ID',
    doc_id VARCHAR(64) NOT NULL COMMENT '关联文档ID',
    doc_name VARCHAR(255) COMMENT '冗余文件名',
    page_num INT COMMENT '来源页码',
    chapter_title VARCHAR(255) COMMENT '章节标题',
    chunk_text LONGTEXT NOT NULL COMMENT '分块纯文本',
    char_start INT COMMENT '原文起始字符位置',
    char_end INT COMMENT '原文结束字符位置',
    split_method VARCHAR(20) DEFAULT 'LLM' COMMENT 'LLM/RULE',
    llm_model VARCHAR(50) COMMENT '分块所用模型',
    status VARCHAR(20) DEFAULT 'active' COMMENT 'active/merged/split/edited',
    merged_into_chunk_id VARCHAR(64) NULL COMMENT '被合并到的目标块ID',
    parent_chunk_id VARCHAR(64) NULL COMMENT '父块ID(粗切块)',
    edited_version_of VARCHAR(64) NULL COMMENT '被编辑的原版块ID',
    quality_score FLOAT COMMENT '检索质量评分0-1',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_doc_id (doc_id),
    INDEX idx_status (status),
    INDEX idx_parent (parent_chunk_id),
    FOREIGN KEY (doc_id) REFERENCES documents(doc_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='文档分块表';

-- 3. 用户反馈表
CREATE TABLE chunk_feedback (
    feedback_id INT AUTO_INCREMENT PRIMARY KEY,
    chunk_id VARCHAR(64) NOT NULL COMMENT '关联分块ID',
    feedback_type VARCHAR(20) COMMENT 'bad_split/wrong_content/missing_context',
    user_comment TEXT COMMENT '用户备注',
    corrected_text LONGTEXT COMMENT '用户修正后的文本',
    old_chunk_text LONGTEXT COMMENT '修正前原文备份',
    user_id VARCHAR(50) COMMENT '反馈人ID',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_chunk_id (chunk_id),
    FOREIGN KEY (chunk_id) REFERENCES document_chunks(chunk_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='分块反馈表';

-- 4. 问答日志（追溯引用）
CREATE TABLE qa_logs (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    question TEXT NOT NULL COMMENT '用户提问',
    answer LONGTEXT COMMENT '系统回答',
    cited_chunk_ids JSON COMMENT '引用的chunk_id列表',
    retrieval_score FLOAT COMMENT '检索相关性得分',
    response_time_ms INT COMMENT '响应耗时(毫秒)',
    user_id VARCHAR(50),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_created (user_id, created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='问答日志';
